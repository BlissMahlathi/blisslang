BuildSection[
    name: "Hero",
    style.tailwind: "relative min-h-screen bg-cover bg-center bg-no-repeat overflow-hidden",
    style.css: "background-image:url('https://krdqveslwceavszvajxo.supabase.co/storage/v1/object/sign/blisslang/blisslangHero.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV8wZmIyZTc4ZC05NDI2LTQxM2EtYjQ4Yi01NWFiYmRlNGM5ZDIiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJibGlzc2xhbmcvYmxpc3NsYW5nSGVyby5wbmciLCJzY29wZSI6ImRvd25sb2FkIiwiaWF0IjoxNzg1MTk1NjAzLCJleHAiOjE5NDI4NzU2MDN9.-bFVFFYI4LWaMll7y4kLNUPFKmbm2dBSV6kXBq6ULog');"
]:

    # Dark overlay
    div[
        style.tailwind: "absolute inset-0 bg-black/60"
    ]

    # Hero Content
    div[
        style.tailwind: "relative z-10 flex flex-col justify-center items-center min-h-screen px-6 text-center"
    ]:

        h1[
            text: "Build Modern Applications with BlissLang"
            style.tailwind: "text-5xl md:text-7xl font-extrabold text-white leading-tight max-w-5xl"
            animate: "fadeInUp"
            animate.trigger: "load"
            animate.duration: "800ms"
        ]

        p[
            text: "A modern compiled programming language for building fast, secure, and maintainable web applications. Write clean, section-based code and ship production-ready software with confidence."
            style.tailwind: "mt-8 text-xl md:text-2xl text-slate-300 max-w-3xl leading-relaxed"
            animate: "fadeInUp"
            animate.delay: "200ms"
        ]

        div[
            style.tailwind: "flex flex-wrap justify-center gap-4 mt-10"
            animate: "fadeInUp"
            animate.delay: "400ms"
        ]:

            button[
                text: "Get Started"
                style.tailwind: "px-8 py-4 bg-red-500 hover:bg-red-600 text-white rounded-xl font-semibold transition-all duration-300 shadow-lg"
                link: "https://github.com/BlissMahlathi/blisslang/blob/main/README.md"
            ]

            button[
                text: "View on GitHub"
                style.tailwind: "px-8 py-4 border border-white text-white rounded-xl font-semibold hover:bg-white hover:text-slate-900 transition-all duration-300"
                link: "https://github.com/BlissMahlathi/blisslang"
            ]

        div[
            style.tailwind: "flex flex-wrap justify-center gap-6 mt-16"
            animate: "fadeInUp"
            animate.delay: "600ms"
        ]:

            span[
                text: "⚡ Native Performance"
                style.tailwind: "bg-white/10 backdrop-blur px-5 py-2 rounded-full text-white text-sm font-medium"
            ]

            span[
                text: "🦀 Rust Powered"
                style.tailwind: "bg-white/10 backdrop-blur px-5 py-2 rounded-full text-white text-sm font-medium"
            ]

            span[
                text: "🧩 Section-Based Architecture"
                style.tailwind: "bg-white/10 backdrop-blur px-5 py-2 rounded-full text-white text-sm font-medium"
            ]

            span[
                text: "🔒 Secure by Design"
                style.tailwind: "bg-white/10 backdrop-blur px-5 py-2 rounded-full text-white text-sm font-medium"
            ]

            span[
                text: "🎨 Built-in Styling"
                style.tailwind: "bg-white/10 backdrop-blur px-5 py-2 rounded-full text-white text-sm font-medium"
            ]

            span[
                text: "🌍 Cross Platform"
                style.tailwind: "bg-white/10 backdrop-blur px-5 py-2 rounded-full text-white text-sm font-medium"
            ]